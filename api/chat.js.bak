export default async function handler(req, res) {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');
  if (req.method === 'OPTIONS') return res.status(200).end();
  if (req.method !== 'POST') return res.status(405).json({ error: 'Method not allowed' });
  try {
    const { message } = req.body;
    const msg = message.toLowerCase();
    const isAgenda = ['agenda','ekitaldi','zer dago','evento','concierto','teatro','zinema','cine','fin de semana','asteburu','hoy','gaur'].some(w=>msg.includes(w));
    let agendaContent = '';
    if (isAgenda) {
      let url = '';
      if (['elgoibar','eibar','ermua','debabarrena','soraluze','mallabia','deba'].some(w=>msg.includes(w))) url='https://barrena.eus/agenda/';
      else if (['beasain','zumarraga','goierri','urretxu','ordizia','lazkao'].some(w=>msg.includes(w))) url='https://goierri.hitza.eus/agenda/gaur/';
      else if (['tolosa','tolosaldea','ibarra'].some(w=>msg.includes(w))) url='https://tolosaldekohitza.eus/agenda/gaur/';
      else if (['irun','hondarribia','bidasoa'].some(w=>msg.includes(w))) url='https://bidasoa.hitza.eus/agenda/gaur/';
      else if (['errenteria','oiartzun','oarsoaldea','pasaia','lezo'].some(w=>msg.includes(w))) url='https://oarsoaldea.hitza.eus/agenda/gaur/';
      else if (['donostia','hernani','donostialdea'].some(w=>msg.includes(w))) url='https://irutxulo.hitza.eus/agenda/gaur/';
      else if (['arrasate','bergara','debagoiena','onati'].some(w=>msg.includes(w))) url='https://goiena.eus/agenda/';
      if (url) {
        try {
          const r2 = await fetch(url, {headers:{'User-Agent':'Mozilla/5.0'}});
          const html = await r2.text();
          agendaContent = html.replace(/<script[\s\S]*?<\/script>/gi,'').replace(/<style[\s\S]*?<\/style>/gi,'').replace(/<[^>]+>/g,' ').replace(/\s+/g,' ').substring(0,3000);
        } catch(e) {}
      }
    }
    let searchResults = '';
    if (!agendaContent) {
      const q = (msg.includes('farmazia')||msg.includes('farmacia')||msg.includes('guardia')) ? message+' site:cofgipuzkoa.eus OR site:euskadi.eus' : message+' site:naiz.info OR site:argia.eus OR site:berria.eus OR site:noticiasdegipuzkoa.eus OR site:oarsoaldea.hitza.eus OR site:barrena.eus';
      try {
        const sr = await fetch('https://api.search.brave.com/res/v1/web/search?q='+encodeURIComponent(q)+'&count=5',{headers:{'Accept':'application/json','X-Subscription-Token':process.env.BRAVE_API_KEY}});
        const sd = await sr.json();
        if (sd.web?.results) searchResults = sd.web.results.slice(0,3).map(r=>'['+r.url+'] '+r.title+': '+r.description).join('\n');
      } catch(e) {}
    }
    const ctx = agendaContent ? 'AGENDA ERREALA:\n'+agendaContent : searchResults ? 'Bilaketa:\n'+searchResults : '';
    const response = await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'Content-Type':'application/json','x-api-key':process.env.ANTHROPIC_API_KEY,'anthropic-version':'2023-06-01'},body:JSON.stringify({model:'claude-opus-4-5',max_tokens:1024,system:'You are Ketako, assistant for Euskal Herria and Gipuzkoa. CRITICAL: Detect user language and reply in THAT EXACT language. Spanish->Spanish, Basque->Basque. Translate source data if needed. Never say Espana. Use Euskal Herria. NEVER cite Diario Vasco or El Correo.'+(ctx?'\n\n'+ctx:''),messages:[{role:'user',content:message}]})});
    const data = await response.json();
    res.json({reply:data.content[0].text});
  } catch(err){res.status(500).json({error:err.message});}
}